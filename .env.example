# ==============================================================================
# CONFIGURATION DE L'ENVIRONNEMENT DE DÉVELOPPEMENT (GESTION FORMATION)
# Copiez ce fichier et renommez-le en `.env` avant de lancer Docker Compose
# ==============================================================================

# --- BASE DE DONNÉES POSTGRESQL ---
DB_NAME=gestion_formation
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_PORT=5432

# --- CONFIGURATION SERVEUR SMTP (MAILHOG EN LOCAL) ---
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH_REQUIRED=false
SMTP_STARTTLS_ENABLE=false

# --- CONFIGURATION BACKEND JAVA SPRING BOOT ---
SPRING_PORT=8080

# --- CONFIGURATION FRONTEND ANGULAR ---
ANGULAR_PORT=4200

# --- CONFIGURATION JWT (utilisee par le profil docker du backend) ---
# Valeur de dev fournie par defaut dans application-docker.properties si non definie.
JWT_SECRET=changeme_dev_secret_replace_me
JWT_EXPIRATION=86400000